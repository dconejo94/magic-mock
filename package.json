{
  "name": "magic-mock",
  "version": "0.1.0",
  "private": true,
  "description": "Platform for playing Magic: The Gathering with physical cards and a synchronized digital game state",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "verify": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm run test && npm run test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.20.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  }
}
